# Docker image for the frontend API.
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080
ENV AUDIT_DB_PATH=/var/data/audit.db UPLOAD_DIR=/var/data/uploads FASTEMBED_CACHE_DIR=/app/model_cache
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && mkdir -p /var/data/uploads /app/model_cache \
    && python -c "from fastembed import TextEmbedding; TextEmbedding(model_name='sentence-transformers/all-MiniLM-L6-v2', cache_dir='/app/model_cache', threads=1)"
COPY app ./app
COPY data/sample_kb ./data/sample_kb
EXPOSE 8080
CMD ["sh", "-c", "python -m uvicorn app.frontend_api:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
